post_remove() {
    command -v plymouth-set-default-theme >/dev/null 2>&1 || return 0
    [ "$(plymouth-set-default-theme 2>/dev/null)" = "airsky-bootanimation" ] || return 0
    for t in cachyos-bootanimation bgrt spinner; do
        if [ -d "/usr/share/plymouth/themes/$t" ]; then
            echo "==> AirSkyOS: switching plymouth theme back to $t"
            plymouth-set-default-theme "$t"
            if [ -x /usr/bin/update-initramfs ]; then /usr/bin/update-initramfs
            elif command -v mkinitcpio >/dev/null 2>&1; then mkinitcpio -P
            elif command -v dracut-rebuild >/dev/null 2>&1; then dracut-rebuild
            fi
            break
        fi
    done
}
