 // Per-frame entry points
 
+// ---------------------------------------------------------------------------
+// AirSkyOS: round the window itself, not just the glass behind it.
+//
+// Aurorae (SVG) decorations cannot declare a border radius, so KWin draws the
+// window with square corners while the glass underneath is rounded with
+// WindowCornerRadius -- the corners of the window stick out of the glass.
+// Give the window's scene item the same radius so KWin's renderer clips it:
+//   * KWin >= 6.7: the window container (decoration + client together)
+//   * KWin 6.6   : only the client surface, bottom corners (the transparent
+//                  title bar sits on top of the rounded glass there)
+// Applied every frame because KWin resets it when the surface is recreated.
+// Only server-side decorated normal windows/dialogs; CSD windows keep their
+// own shadows, and decorations that set a radius themselves (Breeze) win.
+// ---------------------------------------------------------------------------
+static Item* contentCornerItem(EffectWindow* w)
+{
+    WindowItem* item = w->windowItem();
+    if (!item) {
+        return nullptr;
+    }
+#if ACRYLIC_GLASS_KWIN_6_7
+    return item->windowContainer();
+#else
+    return item->surfaceItem();
+#endif
+}
+
+void BlurEffect::resetContentCorners(EffectWindow* w)
+{
+    if (Item* item = contentCornerItem(w); item && w->window()) {
+        item->setBorderRadius(w->window()->borderRadius());
+    }
+}
+
+void BlurEffect::updateContentCorners(EffectWindow* w)
+{
+    Item* item = contentCornerItem(w);
+    if (!item || !w->window()) {
+        return;
+    }
+
+    const BorderRadius native = w->window()->borderRadius();
+    const bool eligible = BlurConfig::clipWindowContent()
+        && native.isNull()
+        && w->decoration()
+        && (w->isNormalWindow() || w->isDialog())
+        && !w->isFullScreen();
+
+    BorderRadius radius = native;
+    if (eligible) {
+        const bool isMaximized = effects->clientArea(MaximizeArea, w).toRect() == w->frameGeometry().toRect();
+        if (!isMaximized || BlurConfig::roundCornersOfMaximizedWindows()) {
+            const QRectF frame = w->frameGeometry();
+            qreal r = std::min<qreal>(BlurConfig::windowCornerRadius(), std::min(frame.width(), frame.height()) / 2.0);
+#if ACRYLIC_GLASS_KWIN_6_7
+            radius = BorderRadius(r);
+#else
+            const qreal bottom = std::max<qreal>(0.0, r - w->decoration()->borders().bottom());
+            radius = BorderRadius(0, 0, bottom, bottom);
+#endif
+        }
+    }
+
+    item->setBorderRadius(radius); // no-op when unchanged
+}
+
