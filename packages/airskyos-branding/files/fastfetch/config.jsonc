// AirSkyOS system-wide fastfetch config (shown when Konsole / fish starts).
// A user config in ~/.config/fastfetch/config.jsonc takes precedence.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/airskyos/fastfetch/logo.txt",
        "color": {
            "1": "38;2;93;173;236",
            "2": "97"
        },
        "padding": {
            "top": 1,
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;93;173;236",
            "title": "97"
        }
    },
    "modules": [
        "title",
        "separator",
        { "type": "os", "key": "OS" },
        { "type": "kernel", "key": "Kernel" },
        { "type": "uptime", "key": "Uptime" },
        { "type": "packages", "key": "Packages" },
        { "type": "shell", "key": "Shell" },
        { "type": "de", "key": "DE" },
        { "type": "wm", "key": "WM" },
        { "type": "theme", "key": "Theme" },
        { "type": "cursor", "key": "Cursor" },
        { "type": "terminal", "key": "Terminal" },
        { "type": "cpu", "key": "CPU" },
        { "type": "gpu", "key": "GPU" },
        { "type": "memory", "key": "Memory" },
        { "type": "disk", "key": "Disk (/)", "folders": "/" },
        "break",
        "colors"
    ]
}
