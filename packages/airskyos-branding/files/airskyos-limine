#!/usr/bin/env bash
# AirSkyOS Limine branding.
#
# The CachyOS installer writes limine.conf with a "CachyOS" menu group, the
# CachyOS colour theme and the CachyOS splash, and CachyOS / Limine updates
# may bring those back. This script (run by zz-airskyos-limine.hook after
# every Limine, CachyOS-settings or kernel update) puts AirSkyOS back:
#
#   * menu group "/+CachyOS" of THIS machine  -> "/+AirSkyOS"
#   * global look (colours, branding, wallpaper) from /etc/airskyos/limine-theme.conf
#   * AirSkyOS splash copied to the EFI partition
#   * TARGET_OS_NAME="AirSkyOS" for limine-snapper-sync / /etc/default/limine
#
# Boot entries themselves are never touched. A backup of limine.conf is kept
# as limine.conf.airskyos-bak. Does nothing if Limine is not in use or
# LIMINE_BRANDING=0 is set in /etc/airskyos/branding.conf.
#
#   airskyos-limine            apply
#   airskyos-limine --check    show what would change, write nothing

set -u

CONF=/etc/airskyos/branding.conf
THEME=/etc/airskyos/limine-theme.conf
SPLASH=/usr/share/airskyos/limine/airskyos-splash.jpg
LIMINE_BRANDING=1
# shellcheck source=/dev/null
[[ -r $CONF ]] && . "$CONF"

OS_NAME=AirSkyOS
FOREIGN_NAMES='CachyOS|CachyOS Linux|Arch Linux'
CHECK=0
[[ ${1:-} == --check ]] && CHECK=1

msg()  { printf '==> AirSkyOS Limine: %s\n' "$*"; }
warn() { printf '==> AirSkyOS Limine WARNING: %s\n' "$*" >&2; }

[[ $LIMINE_BRANDING == 1 ]] || exit 0
((EUID == 0)) || { echo "run as root" >&2; exit 1; }

# limine-entry-tool config files, lowest to highest priority
entry_tool_configs() {
    local f
    for f in /usr/share/limine-entry-tool.d/*.conf /etc/limine-entry-tool.conf \
             /etc/limine-entry-tool.d/*.conf /etc/default/limine; do
        [[ -r $f ]] && printf '%s\n' "$f"
    done
}

config_value() {   # last value of KEY across the entry-tool configs
    local key=$1 f v out=""
    while read -r f; do
        v=$(sed -n "s/^[[:space:]]*$key=[\"']\{0,1\}\([^\"'#]*\)[\"']\{0,1\}.*/\1/p" "$f" | tail -n1)
        [[ -n $v ]] && out=$v
    done < <(entry_tool_configs)
    printf '%s' "$out"
}

find_limine_conf() {
    local esp d
    esp=$(config_value ESP_PATH)
    for d in "$esp" /efi /boot /boot/efi /limine; do
        [[ -n $d && -d $d ]] || continue
        if [[ -f $d/limine.conf ]]; then
            printf '%s\t%s\n' "$d" "$d/limine.conf"; return 0
        elif [[ -f $d/EFI/limine/limine.conf ]]; then
            printf '%s\t%s\n' "$d" "$d/EFI/limine/limine.conf"; return 0
        fi
    done
    return 1
}

# --- TARGET_OS_NAME in the tools' own config files ------------------------
fix_target_names() {
    local f
    for f in /etc/limine-snapper-sync.conf /etc/default/limine; do
        [[ -f $f ]] || continue
        if grep -Eq "^[[:space:]]*TARGET_OS_NAME=[\"']?($FOREIGN_NAMES)[\"']?[[:space:]]*$" "$f"; then
            if ((CHECK)); then
                msg "would set TARGET_OS_NAME=\"$OS_NAME\" in $f"
            else
                sed -i -E "s/^([[:space:]]*TARGET_OS_NAME=).*/\1\"$OS_NAME\"/" "$f"
                msg "TARGET_OS_NAME -> $OS_NAME in $f"
            fi
        fi
    done
}

# --- limine.conf ------------------------------------------------------------
rewrite_limine_conf() {   # in out
    local in=$1 out=$2 mid theme_block
    mid=$(cat /etc/machine-id 2>/dev/null)
    theme_block=$(grep -Ev '^[[:space:]]*(#|$)' "$THEME" 2>/dev/null)

    awk -v mid="$mid" -v name="$OS_NAME" -v foreign="^/(\\+)?($FOREIGN_NAMES)[[:space:]]*$" \
        -v theme="$theme_block" '
    BEGIN {
        n = split(theme, t, "\n")
        for (i = 1; i <= n; i++) {
            k = t[i]; sub(/:.*/, "", k); gsub(/[[:space:]]/, "", k)
            if (k != "") managed[k] = 1
        }
    }
    { line[NR] = $0 }
    END {
        # first top-level entry ("/Name" but not "//sub")
        first = NR + 1
        for (i = 1; i <= NR; i++) if (line[i] ~ /^\/[^\/]/ || line[i] == "/") { first = i; break }

        # which foreign group header belongs to this machine?
        mid_known = 0; own_header = 0
        for (i = 1; i <= NR; i++) {
            if (mid != "" && index(line[i], "machine-id=" mid)) mid_known = 1
            if (line[i] ~ ("^/(\\+)?" name "[[:space:]]*$")) own_header = 1
        }
        headers = 0
        for (i = first; i <= NR; i++) if (line[i] ~ foreign) { headers++; h[headers] = i }
        for (j = 1; j <= headers; j++) {
            i = h[j]; mine = 0
            for (k = i - 3; k <= i + 40 && k <= NR; k++) {
                if (k < 1) continue
                if (k > i && line[k] ~ /^\/[^\/]/) break
                if (mid != "" && index(line[k], "machine-id=" mid)) mine = 1
            }
            if (mine) rename[i] = 1
            else if (headers == 1 && !mid_known && !own_header) rename[i] = 1   # no machine-id anywhere: only one candidate
        }

        # global section: drop old theme lines, then insert the AirSkyOS block
        # before the first "comment:" line (or at the end of the section)
        m = 0
        for (i = 1; i < first; i++) {
            l = line[i]; k = l; sub(/:.*/, "", k); gsub(/[[:space:]]/, "", k)
            if (l ~ /^# (>>>|<<<) AirSkyOS Limine theme/ || l ~ /^# CachyOS Limine theme/ || l ~ /^# Author: diegons490/) continue
            if (k in managed) continue
            kept[++m] = l
        }
        at = m + 1
        for (i = 1; i <= m; i++) if (kept[i] ~ /^comment:/) { at = i; break }
        o = 0
        for (i = 1; i < at; i++) outl[++o] = kept[i]
        outl[++o] = ""
        outl[++o] = "# >>> AirSkyOS Limine theme (managed by airskyos-limine, edit /etc/airskyos/limine-theme.conf)"
        for (i = 1; i <= n; i++) if (t[i] != "") outl[++o] = t[i]
        outl[++o] = "# <<< AirSkyOS Limine theme"
        outl[++o] = ""
        for (i = at; i <= m; i++) outl[++o] = kept[i]
        for (i = first; i <= NR; i++) {
            l = line[i]
            if (i in rename) { plus = (l ~ /^\/\+/) ? "+" : ""; l = "/" plus name }
            outl[++o] = l
        }
        # print, collapsing runs of blank lines
        blank = 0
        for (i = 1; i <= o; i++) {
            if (outl[i] ~ /^[[:space:]]*$/) { if (blank || i == 1) continue; blank = 1 } else blank = 0
            print outl[i]
        }
    }' "$in" >"$out"
}

enroll_if_needed() {
    [[ $(config_value ENABLE_ENROLL_LIMINE_CONFIG) == yes ]] || return 0
    if command -v limine-enroll-config >/dev/null 2>&1; then
        msg "re-enrolling the Limine config checksum"
        limine-enroll-config || warn "limine-enroll-config failed - check before rebooting!"
    else
        warn "ENABLE_ENROLL_LIMINE_CONFIG=yes but limine-enroll-config is missing - check before rebooting!"
    fi
}

main() {
    fix_target_names

    local found esp conf tmp changed=0
    found=$(find_limine_conf) || exit 0          # Limine not in use (or ISO build)
    esp=${found%%$'\t'*}; conf=${found#*$'\t'}

    if [[ -f $SPLASH ]] && ! cmp -s "$SPLASH" "$esp/airskyos-splash.jpg"; then
        if ((CHECK)); then msg "would copy the splash to $esp"; else
            cp -f "$SPLASH" "$esp/airskyos-splash.jpg" && msg "splash -> $esp/airskyos-splash.jpg"
        fi
    fi

    tmp=$(mktemp) || exit 0
    rewrite_limine_conf "$conf" "$tmp"
    if ! cmp -s "$conf" "$tmp"; then
        if ((CHECK)); then
            msg "would change $conf:"; diff -u "$conf" "$tmp" | sed 's/^/    /'
        else
            cp -f "$conf" "$conf.airskyos-bak"
            cat "$tmp" >"$conf" && changed=1
            msg "updated $conf (backup: $conf.airskyos-bak)"
        fi
    fi
    rm -f "$tmp"
    ((changed)) && enroll_if_needed
    exit 0
}

main
