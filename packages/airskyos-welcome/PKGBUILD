# Maintainer: Aozora
pkgname=airskyos-welcome
pkgver=1.3.0
pkgrel=2
pkgdesc="AirSkyOS の初回起動ようこそアプリ (ガラス調 / PySide6 + QML)"
arch=('any')
url="https://github.com/aozora9200/AirSkyOS"
license=('MIT' 'LicenseRef-AirSkyOS-Logo')
depends=('python' 'pyside6' 'qt6-declarative' 'qt6-svg' 'kwindowsystem' 'plasma-workspace' 'dbus' 'pacman' 'sudo')
optdepends=('calamares: ライブ環境でのインストールボタン'
            'airskyos-kde-theme: テーマページで使う ClearSky / ClearSky Dark'
            'konsole: 更新・インストール用ターミナル (推奨)'
            'cachyos-rate-mirrors: ミラー最適化ボタン')
source=()

# PKGBUILD と同じディレクトリのファイルを使う(makepkg をこのフォルダで実行)
package() {
    local src="$startdir"
    install -Dm755 "$src/airskyos-welcome" "$pkgdir/usr/bin/airskyos-welcome"

    local dest="$pkgdir/usr/share/airskyos-welcome/airskyos_welcome"
    install -Dm644 -t "$dest"     "$src"/airskyos_welcome/*.py
    install -Dm644 -t "$dest/qml" "$src"/airskyos_welcome/qml/*

    install -Dm644 "$src/data/airskyos-welcome.desktop" \
        "$pkgdir/usr/share/applications/airskyos-welcome.desktop"
    install -Dm644 "$src/data/airskyos-welcome-autostart.desktop" \
        "$pkgdir/etc/xdg/autostart/airskyos-welcome.desktop"
    install -Dm644 "$src/airskyos_welcome/qml/logo.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/airskyos-welcome.svg"
    install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
